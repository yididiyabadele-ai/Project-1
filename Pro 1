<!-- JavaScript Interactions -->
    <script>
        // 1. Single Page Application (SPA) 3-Page Navigation
        function switchPage(pageId) {
            // Hide all pages
            const pages = document.querySelectorAll('.page-content');
            pages.forEach(p => p.classList.add('hidden'));

            // Show selected page
            const targetPage = document.getElementById('page-' + pageId);
            if (targetPage) {
                targetPage.classList.remove('hidden');
            }

            // Update navbar active state
            const tabs = document.querySelectorAll('.page-tab');
            tabs.forEach(t => t.classList.remove('active'));
            
            const activeTab = document.getElementById('tab-' + pageId);
            if (activeTab) {
                activeTab.classList.add('active');
            }

            // Scroll to top smoothly
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // 2. Mobile Menu Drawer Toggle
        const mobileToggle = document.getElementById('mobile-toggle');
        const mobileMenu = document.getElementById('mobile-menu');

        if (mobileToggle && mobileMenu) {
            mobileToggle.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }

        function closeMobileMenu() {
            if (mobileMenu) {
                mobileMenu.classList.add('hidden');
            }
        }

        // 3. Menu Category Filter Function
        function filterMenu(e, category) {
            const filters = document.querySelectorAll('.menu-filter');
            filters.forEach(f => f.classList.remove('active'));

            // Highlight active filter button
            if (e && e.target) {
                e.target.classList.add('active');
            }

            const cards = document.querySelectorAll('.menu-card');
            cards.forEach(card => {
                if (category === 'all' || card.getAttribute('data-category') === category) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
